---
// For gig-goers. Copy source: 10-Projects\bndy-website\for-gig-goers.md (byte-exact).
// Shortest page. Display-led per spec §4.
import Base from '../layouts/Base.astro';
import { MAP_URL } from '../config';
---
<Base
  title="Turn up · bndy"
  description="Turn up. That's it. That's the secret. Go to gigs, try a band you've never heard of, walk into a venue you've never visited."
  path="/go"
>
  <section class="rally">
    <div class="kicker mono" style="font-size:.76rem;letter-spacing:.18em;text-transform:uppercase;color:var(--cyan)">For everyone who cares about local music</div>
    <h1 class="rally-display tight" style="margin-top:1rem">Turn up.</h1>
    <p class="reveal stagger-1">That's it. That's the secret.</p>
    <p class="reveal stagger-2">Every band you've ever loved started in a small room in front of a handful of people. Every great venue stays open one decent night at a time.</p>
    <p class="reveal stagger-3">So:</p>
    <ul class="rally-list">
      <li class="reveal-left stagger-1"><span class="n">01</span>Go to gigs.</li>
      <li class="reveal-right stagger-2"><span class="n">02</span>Try a band you've never heard of.</li>
      <li class="reveal-left stagger-3"><span class="n">03</span>Walk into a venue you've never visited.</li>
      <li class="reveal-right stagger-4"><span class="n">04</span>Spend some money at the bar.</li>
      <li class="reveal-left stagger-5"><span class="n">05</span>Tell somebody when a band was brilliant.</li>
      <li class="reveal-right stagger-6"><span class="n">06</span>Take your mates next time.</li>
    </ul>
    <p class="reveal" style="margin-top:2.2rem">Because grassroots live music only stays alive if people turn up.</p>
    <p class="reveal stagger-1"><b>We'll help you find it. The rest is up to all of us.</b></p>
    <div class="close-actions reveal stagger-2" style="justify-content:flex-start">
      <a class="btn btn-primary" href={MAP_URL}>Open the map and see what's on near you tonight</a>
    </div>
  </section>
</Base>
